# Git metadata and local tooling
.git
.gitignore
.github
.vscode
.idea

# Dependencies and build outputs
**/node_modules
**/.next
**/dist
**/build
**/coverage
**/.dart_tool
**/.flutter-plugins*

# Local/runtime configuration and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore

# Local data and transient files
**/*.log
**/*.tmp
**/*.swp
**/.DS_Store
**/tmp
**/temp
