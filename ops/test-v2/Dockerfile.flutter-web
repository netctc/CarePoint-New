FROM debian:bookworm-slim AS build

ARG FLUTTER_VERSION=3.47.2
ARG APP_PATH
ARG APP_TITLE=CarePoint Test
ARG CAREPOINT_API_BASE

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:${PATH}

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git unzip xz-utils zip libglu1-mesa \
 && rm -rf /var/lib/apt/lists/* \
 && git clone --depth 1 --branch "${FLUTTER_VERSION}" https://github.com/flutter/flutter.git /opt/flutter \
 && flutter config --enable-web \
 && flutter precache --web \
 && flutter --version

WORKDIR /workspace
COPY packages/mobile_core packages/mobile_core
COPY ${APP_PATH} ${APP_PATH}

WORKDIR /workspace/${APP_PATH}
RUN flutter pub get \
 && flutter build web --release --dart-define=CAREPOINT_API_BASE=${CAREPOINT_API_BASE} \
 && mkdir -p /out \
 && cp -a build/web/. /out/

FROM nginx:1.27-alpine
COPY ops/test-v2/nginx/flutter-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /out /usr/share/nginx/html
EXPOSE 80
