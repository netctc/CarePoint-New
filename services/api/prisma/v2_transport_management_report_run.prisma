model TransportManagementReportRun {
  id                   String   @id @default(uuid())
  scheduleId           String
  schedule             TransportManagementReportSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduledFor         DateTime
  status               String   @default("QUEUED")
  attemptCount         Int      @default(0)
  claimedAt            DateTime?
  leaseExpiresAt       DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  failedAt             DateTime?
  lastError            String?
  reportGeneratedAt    DateTime?
  reportFilename       String?
  reportFormat         String?
  rowCount             Int?
  truncatedSource      Boolean  @default(false)
  snapshotHash         String?
  snapshotJson         String?
  artifactObjectKey    String?
  artifactSha256       String?
  artifactBytes        Int?
  artifactContentType  String?
  artifactStorageProvider String?
  artifactStoredAt     DateTime?
  deliveryStatus       String   @default("NOT_READY")
  deliveryHandoffPreparedAt DateTime?
  deliveryHandoffPreparedByAccountId String?
  createdByAccountId   String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([scheduleId, scheduledFor])
  @@index([status, leaseExpiresAt])
  @@index([scheduleId, createdAt])
  @@index([deliveryStatus, artifactStoredAt])
}
