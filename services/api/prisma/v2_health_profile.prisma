model PatientHealthProfile {
  id         String            @id @default(uuid())
  patientId  String            @unique
  version    Int               @default(1)
  algorithm  String
  keyId      String
  wrappedKey String
  iv         String
  ciphertext String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  patient    PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  revisions  ProfileRevision[]

  @@index([updatedAt])
}

model ProfileRevision {
  id            String               @id @default(uuid())
  profileId     String
  version       Int
  sourceType    String
  sourceActorId String?
  changedFields Json
  algorithm     String
  keyId         String
  wrappedKey    String
  iv            String
  ciphertext    String
  createdAt     DateTime             @default(now())
  profile       PatientHealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, version])
  @@index([profileId, createdAt])
}
