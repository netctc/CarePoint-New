model TransportOperationalEscalation {
  id                      String   @id @default(uuid())
  transportRequestId      String
  code                    String
  severity                String
  status                  String   @default("OPEN")
  recommendedAction       String
  firstTriggeredAt        DateTime
  lastTriggeredAt         DateTime
  occurrenceCount         Int      @default(1)
  acknowledgedAt          DateTime?
  acknowledgedByAccountId String?
  resolvedAt              DateTime?
  resolvedByAccountId     String?
  resolutionNote          String?
  autoResolved            Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([transportRequestId, code])
  @@index([status, severity, lastTriggeredAt])
  @@index([transportRequestId, status])
  @@index([lastTriggeredAt])
}
