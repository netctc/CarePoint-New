enum EmergencyContactStatus {
  ACTIVE
  REVOKED
}

model EmergencyContact {
  id            String                 @id @default(uuid())
  patientId     String
  displayName   String
  relationship  String
  phone         String
  algorithm     String?
  keyId         String?
  wrappedKey    String?
  iv            String?
  ciphertext    String?
  priority      Int
  status        EmergencyContactStatus @default(ACTIVE)
  revokedAt     DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([patientId, status, priority])
  @@index([patientId, updatedAt])
}
