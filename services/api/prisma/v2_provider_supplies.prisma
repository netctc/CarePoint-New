model SupplyItem {
  id        String        @id @default(uuid())
  code      String        @unique
  labels    Json
  unitCode  String
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  usages    SupplyUsage[]

  @@index([active, code])
}

model SupplyUsage {
  id             String     @id @default(uuid())
  idempotencyKey String     @unique
  sourceType     String
  sourceId       String
  providerId     String
  patientId      String
  supplyItemId   String
  quantity       Decimal    @db.Decimal(12, 3)
  unitCode       String
  actorAccountId String
  recordedAt     DateTime   @default(now())
  supplyItem     SupplyItem @relation(fields: [supplyItemId], references: [id], onDelete: Restrict)

  @@index([sourceType, sourceId, recordedAt])
  @@index([providerId, recordedAt])
  @@index([supplyItemId, recordedAt])
}
