generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { PATIENT DOCTOR OTHER_PROVIDER ADMIN SUPPORT }
enum AccountStatus { ACTIVE SUSPENDED ARCHIVED }
enum ProviderClass { DOCTOR OTHER_PROVIDER }
enum ProviderStatus { DRAFT PENDING_REVIEW ACTIVE SUSPENDED REJECTED }
enum AppointmentModality { CLINIC TELEMEDICINE HOME_VISIT }
enum AppointmentStatus { REQUESTED CONFIRMED CANCELLED COMPLETED NO_SHOW }
enum EmergencyAmbulanceStatus { REQUESTED DISPATCHING ASSIGNED EN_ROUTE ARRIVED TRANSPORTING COMPLETED CANCELLED }

model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  role UserRole
  status AccountStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patientProfile PatientProfile?
  provider Provider?
}

model PatientProfile {
  id String @id @default(uuid())
  userId String @unique
  firstName String
  lastName String
  phone String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  emergencyRequests EmergencyAmbulanceRequest[]
  clinicalRecords ClinicalRecord[]
  consents Consent[]
}

model Provider {
  id String @id @default(uuid())
  userId String? @unique
  class ProviderClass
  displayName String
  legalName String?
  status ProviderStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  doctorProfile DoctorProfile?
  otherProviderProfile OtherProviderProfile?
  credentials ProviderCredential[]
  services Service[]
  slots AvailabilitySlot[]
  appointments Appointment[]
  assignedEmergencyRequests EmergencyAmbulanceRequest[] @relation("EmergencyAssignedProvider")
}

model MedicalSpecialty {
  id String @id @default(uuid())
  code String @unique
  labels Json
  parentId String?
  active Boolean @default(true)
  parent MedicalSpecialty? @relation("SpecialtyHierarchy", fields: [parentId], references: [id])
  children MedicalSpecialty[] @relation("SpecialtyHierarchy")
  doctors DoctorSpecialty[]
}

model DoctorProfile {
  id String @id @default(uuid())
  providerId String @unique
  licenseNumber String
  licenseIssuer String?
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  specialties DoctorSpecialty[]
}

model DoctorSpecialty {
  doctorId String
  specialtyId String
  primary Boolean @default(false)
  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty MedicalSpecialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  @@id([doctorId, specialtyId])
}

model ProviderCategory {
  id String @id @default(uuid())
  slug String @unique
  labels Json
  family String
  active Boolean @default(true)
  requiredCredentialTypes Json
  capabilities Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  providers OtherProviderProfile[]
}

model OtherProviderProfile {
  id String @id @default(uuid())
  providerId String @unique
  categoryId String
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category ProviderCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
}

model ProviderCredential {
  id String @id @default(uuid())
  providerId String
  type String
  issuer String?
  number String?
  validFrom DateTime?
  validUntil DateTime?
  status String
  documentId String?
  createdAt DateTime @default(now())
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  @@index([providerId, type, status])
}

model Service {
  id String @id @default(uuid())
  providerId String
  name String
  description String?
  currency String @default("USD")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modalities ServiceModality[]
  slots AvailabilitySlot[]
  appointments Appointment[]
}

model ServiceModality {
  id String @id @default(uuid())
  serviceId String
  modality AppointmentModality
  durationMinutes Int
  priceMinor Int
  coverage Json?
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@unique([serviceId, modality])
}

model AvailabilitySlot {
  id String @id @default(uuid())
  providerId String
  serviceId String?
  startsAt DateTime
  endsAt DateTime
  capacity Int @default(1)
  version Int @default(1)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@index([providerId, startsAt, endsAt])
}

model Appointment {
  id String @id @default(uuid())
  patientId String
  providerId String
  serviceId String
  modality AppointmentModality
  status AppointmentStatus @default(REQUESTED)
  startsAt DateTime
  endsAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  @@index([providerId, startsAt, status])
  @@index([patientId, startsAt])
}

model EmergencyAmbulanceRequest {
  id String @id @default(uuid())
  patientId String
  status EmergencyAmbulanceStatus @default(REQUESTED)
  latitude Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  pickupAddress String?
  callbackPhone String?
  note String?
  assignedProviderId String?
  etaMinutes Int?
  requestedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  assignedProvider Provider? @relation("EmergencyAssignedProvider", fields: [assignedProviderId], references: [id], onDelete: SetNull)
  @@index([status, requestedAt])
  @@index([assignedProviderId, status])
}

model ClinicalRecord {
  id String @id @default(uuid())
  patientId String
  providerId String
  encounterRef String?
  algorithm String
  keyId String
  wrappedKey String
  iv String
  ciphertext String
  createdAt DateTime @default(now())
  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  @@index([patientId, createdAt])
  @@index([providerId, createdAt])
}

model Consent {
  id String @id @default(uuid())
  patientId String
  providerId String?
  scope String
  version String
  granted Boolean
  grantedAt DateTime
  expiresAt DateTime?
  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([patientId, providerId, scope])
}

model AuditEvent {
  id String @id @default(uuid())
  actorId String?
  action String
  objectType String
  objectId String?
  purpose String?
  result String
  metadata Json?
  occurredAt DateTime @default(now())
  @@index([actorId, occurredAt])
  @@index([objectType, objectId, occurredAt])
}
