enum ClinicalDocumentKind {
  CLINICAL_ATTACHMENT
  LAB_REPORT
  IMAGING_REPORT
  IMAGING_REFERENCE
  PATHOLOGY_REPORT
  PATIENT_UPLOAD
  OTHER
}

enum ClinicalDocumentStatus {
  AVAILABLE
  SUPERSEDED
  REMOVED
}

enum DocumentStorageMode {
  ENCRYPTED_BLOB
  EXTERNAL_REFERENCE
}

enum DiagnosticReportType {
  IMAGING
  PATHOLOGY
  OTHER
}

enum DiagnosticReportStatus {
  DRAFT
  FINAL
  RELEASED
}

model ClinicalDocument {
  id                   String                  @id @default(uuid())
  patientId            String
  providerId           String?
  encounterRef         String?
  orderId              String?
  kind                 ClinicalDocumentKind
  status               ClinicalDocumentStatus @default(AVAILABLE)
  storageMode          DocumentStorageMode
  storageProvider      String
  objectKey            String?                 @unique
  mediaType            String?
  byteLength           Int?
  contentDigest        String?
  blobAlgorithm        String?
  blobKeyId            String?
  blobWrappedKey       String?
  blobIv               String?
  metadataAlgorithm    String
  metadataKeyId        String
  metadataWrappedKey   String
  metadataIv           String
  metadataCiphertext   String
  releasedToPatient    Boolean                 @default(false)
  createdByAccountId   String
  releasedAt           DateTime?
  removedAt            DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([patientId, status, createdAt])
  @@index([providerId, createdAt])
  @@index([encounterRef, kind, status])
  @@index([orderId, kind, status])
}

model ClinicalDocumentDownloadGrant {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  documentId String
  accountId  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([documentId, accountId, expiresAt])
  @@index([expiresAt, consumedAt])
}

model PatientClinicalDocumentReceipt {
  id             String   @id @default(uuid())
  documentId     String
  accountId      String
  firstOpenedAt  DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([documentId, accountId])
  @@index([accountId, acknowledgedAt, createdAt])
  @@index([documentId, accountId])
}

model DiagnosticReport {
  id                   String                  @id @default(uuid())
  patientId            String
  providerId           String
  encounterRef         String
  documentId           String?
  type                 DiagnosticReportType
  status               DiagnosticReportStatus @default(DRAFT)
  algorithm            String
  keyId                String
  wrappedKey           String
  iv                   String
  ciphertext           String
  payloadDigest        String
  signatureAlgorithm   String?
  signatureKeyId       String?
  signature            String?
  finalizedAt          DateTime?
  releasedAt           DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([patientId, status, createdAt])
  @@index([providerId, createdAt])
  @@index([encounterRef, type, status])
  @@index([documentId])
}
