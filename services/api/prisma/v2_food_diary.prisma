model FoodDiaryEntry {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  patientId      String
  mealAt         DateTime
  mealType       String
  shared         Boolean  @default(false)
  version        Int      @default(1)
  algorithm      String
  keyId          String
  wrappedKey     String
  iv             String
  ciphertext     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  comments       FoodDiaryProfessionalComment[]

  @@index([patientId, mealAt])
  @@index([patientId, shared, mealAt])
}

model FoodDiaryProfessionalComment {
  id             String         @id @default(uuid())
  idempotencyKey String         @unique
  entryId        String
  providerId     String
  appointmentId  String
  algorithm      String
  keyId          String
  wrappedKey     String
  iv             String
  ciphertext     String
  createdAt      DateTime       @default(now())
  entry          FoodDiaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, createdAt])
  @@index([providerId, createdAt])
}
