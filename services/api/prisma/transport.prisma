enum MedicalTransportMode {
  GROUND
  AIR
}

enum MedicalTransportStatus {
  REQUESTED
  ASSIGNED
  EN_ROUTE
  ARRIVED
  TRANSPORTING
  COMPLETED
  CANCELLED
}

enum MedicalTransportAssistance {
  STANDARD
  WHEELCHAIR
  STRETCHER
}

enum MedicalTransportEquipment {
  OXYGEN
  MONITORING
  VENTILATION
}

model MedicalTransportRequest {
  id                       String                      @id @default(uuid())
  patientId                String
  mode                     MedicalTransportMode
  status                   MedicalTransportStatus      @default(REQUESTED)
  assistance               MedicalTransportAssistance  @default(STANDARD)
  companionCount           Int                         @default(0)
  equipment                MedicalTransportEquipment[] @default([])
  scheduledFor             DateTime
  pickupLatitude           Decimal                     @db.Decimal(9, 6)
  pickupLongitude          Decimal                     @db.Decimal(9, 6)
  pickupAddress            String?
  destinationLatitude      Decimal                     @db.Decimal(9, 6)
  destinationLongitude     Decimal                     @db.Decimal(9, 6)
  destinationAddress       String?
  callbackPhone            String?
  assignedProviderId       String?
  etaMinutes               Int?
  clientRequestId          String
  cancellationReason       String?
  cancelledAt              DateTime?
  assignedAt               DateTime?
  enRouteAt                DateTime?
  arrivedAt                DateTime?
  transportingAt           DateTime?
  completedAt              DateTime?
  requestedAt              DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  patient                  PatientProfile              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  assignedProvider         Provider?                   @relation("AssignedMedicalTransportProvider", fields: [assignedProviderId], references: [id], onDelete: SetNull)
  events                   MedicalTransportEvent[]

  @@unique([patientId, clientRequestId])
  @@index([patientId, requestedAt])
  @@index([mode, status, scheduledFor])
  @@index([assignedProviderId, status, scheduledFor])
}

model MedicalTransportEvent {
  id                 String                 @id @default(uuid())
  transportRequestId String
  actorAccountId     String?
  fromStatus         MedicalTransportStatus?
  toStatus           MedicalTransportStatus
  providerId         String?
  etaMinutes         Int?
  occurredAt         DateTime               @default(now())
  request            MedicalTransportRequest @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  actor              User?                  @relation("MedicalTransportEventActor", fields: [actorAccountId], references: [id], onDelete: SetNull)
  provider           Provider?              @relation("MedicalTransportEventProvider", fields: [providerId], references: [id], onDelete: SetNull)

  @@index([transportRequestId, occurredAt])
  @@index([providerId, occurredAt])
}

model EmergencyRequestIdempotency {
  id                 String                    @id @default(uuid())
  patientId          String
  clientRequestId    String
  emergencyRequestId String                    @unique
  createdAt          DateTime                  @default(now())
  patient            PatientProfile            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  request            EmergencyAmbulanceRequest @relation(fields: [emergencyRequestId], references: [id], onDelete: Cascade)

  @@unique([patientId, clientRequestId])
}

model EmergencyDispatchEvent {
  id                 String                   @id @default(uuid())
  emergencyRequestId String
  actorAccountId     String?
  fromStatus         EmergencyAmbulanceStatus?
  toStatus           EmergencyAmbulanceStatus
  providerId         String?
  etaMinutes         Int?
  occurredAt         DateTime                 @default(now())
  request            EmergencyAmbulanceRequest @relation(fields: [emergencyRequestId], references: [id], onDelete: Cascade)
  actor              User?                    @relation("EmergencyDispatchEventActor", fields: [actorAccountId], references: [id], onDelete: SetNull)
  provider           Provider?                @relation("EmergencyDispatchEventProvider", fields: [providerId], references: [id], onDelete: SetNull)

  @@index([emergencyRequestId, occurredAt])
  @@index([providerId, occurredAt])
}
