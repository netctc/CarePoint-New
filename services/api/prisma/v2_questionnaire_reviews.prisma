model QuestionnaireResponseReview {
  id              String   @id @default(uuid())
  responseId      String
  patientId       String
  responseSequence Int
  providerId      String
  reviewerActorId String
  reviewedAt      DateTime @default(now())

  @@unique([responseId, providerId])
  @@index([patientId, reviewedAt])
  @@index([providerId, reviewedAt])
}
