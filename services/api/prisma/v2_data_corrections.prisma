model DataCorrectionRequest {
  id                 String   @id @default(uuid())
  patientId          String
  entryId            String
  entryVersion       Int
  reasonCode         String
  status             String   @default("OPEN")
  version            Int      @default(1)
  requesterActorId   String
  algorithm          String
  keyId              String
  wrappedKey         String
  iv                 String
  ciphertext         String
  resolvedByActorId  String?
  resolvedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([patientId, status, createdAt])
  @@index([entryId, status, createdAt])
}

model CorrectionDecision {
  id                 String   @id @default(uuid())
  requestId          String
  action             String
  actorAccountId     String
  entryVersionBefore Int
  entryVersionAfter  Int?
  algorithm          String
  keyId              String
  wrappedKey         String
  iv                 String
  ciphertext         String
  createdAt          DateTime @default(now())

  @@index([requestId, createdAt])
}
