{
  "name": "@carepoint/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "prisma generate --schema prisma",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "npm run c3:object-storage-preflight && npm run c4:redis-preflight && npm run c5:postgres-preflight && npm run c6:otel-preflight && npm run c7:notification-outbox && npm run c8:kms-rotation-preflight && npm run c9:siem-audit-export && npm run c10:static-security && npm run c11:postgres-recovery && npm run c12:external-secret-rotation && npm run c13:financial-gateway-egress && npm run c14:bounded-provider-responses && npm run c15:nonfinancial-http-egress && npm run c17:livekit-endpoint-readiness && npm run c18:smart-public-endpoint-readiness && npm run c19:browser-origin-readiness",
    "typecheck": "prisma generate --schema prisma && tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate --schema prisma",
    "db:migrate": "prisma migrate dev --schema prisma",
    "db:deploy": "prisma migrate deploy --schema prisma",
    "db:bootstrap": "node dist/scripts/bootstrap-platform.js",
    "auth:cleanup": "node dist/scripts/cleanup-auth-artifacts.js",
    "c1:kms-preflight": "node scripts/c1-kms-preflight-smoke.mjs",
    "c3:object-storage-preflight": "node scripts/c3-object-storage-preflight-smoke.mjs",
    "c4:redis-preflight": "node scripts/c4-redis-preflight-smoke.mjs",
    "c5:postgres-preflight": "node scripts/c5-postgres-preflight-smoke.mjs",
    "c6:otel-preflight": "node scripts/c6-otel-preflight-smoke.mjs",
    "c7:notification-outbox": "node scripts/c7-notification-outbox-smoke.mjs",
    "c8:kms-rotation-preflight": "node scripts/c8-kms-rotation-preflight-smoke.mjs",
    "c9:siem-audit-export": "node scripts/c9-siem-audit-export-smoke.mjs",
    "c10:static-security": "node scripts/c10-static-security-gate-smoke.mjs",
    "c11:postgres-recovery": "node scripts/c11-postgres-recovery-gate-smoke.mjs",
    "c12:external-secret-rotation": "node scripts/c12-external-secret-rotation-smoke.mjs",
    "c13:financial-gateway-egress": "node scripts/c13-financial-gateway-egress-smoke.mjs",
    "c14:bounded-provider-responses": "node scripts/c14-bounded-provider-responses-smoke.mjs",
    "c15:nonfinancial-http-egress": "node scripts/c15-nonfinancial-http-egress-smoke.mjs",
    "c17:livekit-endpoint-readiness": "node scripts/c17-livekit-endpoint-readiness-smoke.mjs",
    "c18:smart-public-endpoint-readiness": "node scripts/c18-smart-public-endpoint-readiness-smoke.mjs",
    "c19:browser-origin-readiness": "node scripts/c19-browser-origin-readiness-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1128.0",
    "@aws-sdk/client-s3": "3.1128.0",
    "@carepoint/contracts": "0.1.0",
    "@carepoint/identity": "0.1.0",
    "@carepoint/security": "0.1.0",
    "@nestjs/common": ">=11 <12",
    "@nestjs/core": ">=11 <12",
    "@nestjs/platform-express": ">=11 <12",
    "@prisma/client": ">=6 <7",
    "dayjs": ">=1.11 <2",
    "dotenv": ">=16 <17",
    "helmet": ">=8 <9",
    "ioredis": ">=5 <6",
    "livekit-server-sdk": ">=2.18 <3",
    "reflect-metadata": ">=0.2 <1",
    "rxjs": ">=7 <8"
  },
  "devDependencies": {
    "@nestjs/cli": ">=11 <12",
    "@types/node": ">=22 <25",
    "prisma": ">=6 <7",
    "typescript": ">=5.8 <6"
  }
}
