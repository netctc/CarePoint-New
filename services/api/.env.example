NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://carepoint:carepoint@localhost:5432/carepoint?schema=public
DATABASE_POOL_MODE=
DATABASE_HA_MODE=
DATABASE_PITR_MODE=
DATABASE_MIN_SERVER_MAJOR=16
DATABASE_MIN_STREAMING_REPLICAS=1
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_MIN_REPLICAS=1
REDIS_PERSISTENCE_MODE=
ALLOWED_ORIGINS=http://localhost:3000

# Phase C6 OpenTelemetry OTLP/HTTP JSON. Development may leave endpoints empty. Production
# requires an OTLP endpoint (or both signal-specific endpoints), HTTPS, http/json and an
# explicit CAREPOINT_OTEL_EXPORT_MODE=required|best-effort. Keep real collector credentials
# in the runtime secret manager; never commit them here.
CAREPOINT_OTEL_EXPORT_MODE=best-effort
CAREPOINT_OTEL_MAX_QUEUE=2048
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
OTEL_EXPORTER_OTLP_METRICS_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT=10000
OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=
OTEL_EXPORTER_OTLP_METRICS_TIMEOUT=
OTEL_SERVICE_NAME=carepoint-api
OTEL_SERVICE_NAMESPACE=carepoint
OTEL_SERVICE_VERSION=
OTEL_DEPLOYMENT_ENVIRONMENT=development
OTEL_METRIC_EXPORT_INTERVAL=5000
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=
OTEL_SDK_DISABLED=false

# Phase C5 production PostgreSQL override example. Keep the real user/password/token in the
# runtime secret manager. Production requires TLS, an explicit Prisma connection_limit,
# DATABASE_POOL_MODE=direct|pgbouncer|managed, DATABASE_HA_MODE=replicated|managed and
# DATABASE_PITR_MODE=native|managed.
# DATABASE_URL=postgresql://carepoint:<runtime-secret>@private-db.example.internal:5432/carepoint?schema=public&sslmode=verify-full&connection_limit=10
# For PgBouncer transaction pooling also set DATABASE_POOL_MODE=pgbouncer and pgbouncer=true in DATABASE_URL.
# DATABASE_HA_MODE=replicated validates pg_stat_replication against DATABASE_MIN_STREAMING_REPLICAS.
# DATABASE_HA_MODE=managed means HA/failover is provider-managed and needs separate infrastructure evidence.
# DATABASE_PITR_MODE=native validates WAL/archive settings visible through PostgreSQL.
# DATABASE_PITR_MODE=managed means PITR/backups are provider-managed and need separate restore evidence.

# Phase C4 production Redis override example. Keep the actual password/token in the runtime
# secret manager, not in source control. Production requires rediss://, authentication,
# a writable primary and REDIS_PERSISTENCE_MODE=aof|rdb|managed.
# REDIS_URL=rediss://default:<runtime-secret>@private-redis.example.internal:6379
# REDIS_MIN_REPLICAS defaults to 1. Setting 0 is an explicit architecture exception and
# requires separate evidence that the managed provider supplies equivalent HA/failover.
# REDIS_PERSISTENCE_MODE=managed means durability is provider-managed and cannot be proven
# through the Redis protocol; verify backups/persistence separately in infrastructure acceptance.
# Never set REDIS_TLS_REJECT_UNAUTHORIZED=false in production.

# Local/development MFA secret envelope encryption only.
# Generate a 32-byte key, for example: openssl rand -base64 32
MFA_KEY_PROVIDER=local
MFA_ENVELOPE_KEY_ID=local-mfa-kek-v1
MFA_ENVELOPE_KEY_BASE64=

# Local/development clinical PHI encryption only.
CLINICAL_KEY_PROVIDER=local
CLINICAL_ENVELOPE_KEY_ID=local-clinical-kek-v1
CLINICAL_ENVELOPE_KEY_BASE64=

# Local/development order/result encryption and attestation only.
ORDER_KEY_PROVIDER=local
ORDER_ENVELOPE_KEY_ID=local-orders-kek-v1
ORDER_ENVELOPE_KEY_BASE64=
ORDER_SIGNING_PROVIDER=local
ORDER_SIGNING_KEY_ID=local-orders-signing-v1
ORDER_SIGNING_SECRET_BASE64=

# Slice 5/5.1 clinical documents.
# Development/test may use the local adapters below. Production forbids them.
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_LOCAL_ROOT=/tmp/carepoint-documents
DOCUMENT_KEY_PROVIDER=local
DOCUMENT_ENVELOPE_KEY_ID=local-documents-kek-v1
DOCUMENT_ENVELOPE_KEY_BASE64=
DOCUMENT_SIGNING_PROVIDER=local
DOCUMENT_SIGNING_KEY_ID=local-documents-signing-v1
DOCUMENT_SIGNING_SECRET_BASE64=
DOCUMENT_SCAN_PROVIDER=mock
DICOMWEB_PROVIDER=mock

# Slice 7 secure messaging local/development envelope encryption.
MESSAGING_KEY_PROVIDER=local
MESSAGING_ENVELOPE_KEY_ID=local-messaging-kek-v1
MESSAGING_ENVELOPE_KEY_BASE64=

# Telehealth local/development adapters.
TELEHEALTH_PROVIDER=mock
TELEHEALTH_KEY_PROVIDER=local
TELEHEALTH_ENVELOPE_KEY_ID=local-telehealth-kek-v1
TELEHEALTH_ENVELOPE_KEY_BASE64=
TELEHEALTH_MOCK_SIGNING_SECRET=

# Production infrastructure values. Use workload identity / instance or task roles;
# never place long-lived AWS access keys in this file.
AWS_REGION=
# Optional 12-digit AWS account pin for every application KMS key resolved by C1.
AWS_KMS_ACCOUNT_ID=

# Phase C1 production KMS overrides. Uncomment/set these in the production deployment
# instead of changing the development defaults above in the shared example file.
# MFA_KEY_PROVIDER=aws-kms
MFA_KMS_KEY_ID=
# CLINICAL_KEY_PROVIDER=aws-kms
CLINICAL_KMS_KEY_ID=
# ORDER_KEY_PROVIDER=aws-kms
ORDER_KMS_KEY_ID=
# ORDER_SIGNING_PROVIDER=aws-kms-hmac
ORDER_SIGNING_KMS_KEY_ID=
# DOCUMENT_KEY_PROVIDER=aws-kms
DOCUMENT_KMS_KEY_ID=
# DOCUMENT_SIGNING_PROVIDER=aws-kms-hmac
DOCUMENT_SIGNING_KMS_KEY_ID=
# MESSAGING_KEY_PROVIDER=aws-kms
MESSAGING_KMS_KEY_ID=
# TELEHEALTH_KEY_PROVIDER=aws-kms
TELEHEALTH_KMS_KEY_ID=

# C1 requirements:
# - every application KMS key must be CUSTOMER-managed, enabled and in AWS_REGION;
# - ENCRYPT_DECRYPT keys must use SYMMETRIC_DEFAULT;
# - signing keys must use HMAC_256 / GENERATE_VERIFY_MAC and support HMAC_SHA_256;
# - when AWS_KMS_ACCOUNT_ID is set, all application key ARNs must belong to it;
# - AWS_ENDPOINT_URL_KMS is forbidden when NODE_ENV=production.

# Production clinical-document/storage example. These provider overrides are intentionally
# comments so copying this file still yields a usable development configuration.
# Phase C3 additionally validates the S3 bucket region, Block Public Access, BucketOwnerEnforced,
# default SSE-KMS key and the storage KMS key metadata before the API starts.
# DOCUMENT_STORAGE_PROVIDER=s3
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_PREFIX=carepoint/clinical
DOCUMENT_S3_KMS_KEY_ID=
DOCUMENT_S3_FORCE_PATH_STYLE=false
# DOCUMENT_SCAN_PROVIDER=clamav
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
# DICOMWEB_PROVIDER=dicomweb
DICOMWEB_BASE_URL=

# Development/test compatibility endpoints only. Both are forbidden in production.
AWS_ENDPOINT_URL_S3=
AWS_ENDPOINT_URL_KMS=

# Slice 6 payments. Mock is development/test only; production defaults to external.
# Card PAN/CVV must never be sent to CarePoint. Use only an opaque PSP paymentMethodToken.
PAYMENT_GATEWAY_PROVIDER=mock
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_API_KEY=

# Slice 6 insurance. externalPolicyRef must be an opaque reference issued by the payer/clearinghouse integration.
INSURANCE_GATEWAY_PROVIDER=mock
INSURANCE_GATEWAY_BASE_URL=
INSURANCE_GATEWAY_API_KEY=
INSURANCE_MOCK_PREAUTH_THRESHOLD_MINOR=10000

# Slice 6.2 claims/revenue cycle. Mock is development/test only; production defaults to external.
# The adapter sends normalized financial/claim context only. Do not place raw clinical notes or payer payloads in claim persistence.
CLAIMS_GATEWAY_PROVIDER=mock
CLAIMS_GATEWAY_BASE_URL=
CLAIMS_GATEWAY_API_KEY=
CLAIMS_MOCK_DENIAL_THRESHOLD_MINOR=100000

# Slice 7 notification delivery. Mock is development/test only; production defaults to external.
# External notification payloads carry PHI-neutral template keys and internal entity references, never secure-message bodies or clinical notes.
NOTIFICATION_GATEWAY_PROVIDER=mock
NOTIFICATION_GATEWAY_BASE_URL=
NOTIFICATION_GATEWAY_API_KEY=
NOTIFICATION_GATEWAY_TIMEOUT_MS=10000

# Phase C7 durable notification outbox worker. PostgreSQL is the source of truth.
# Production currently requires this in-process worker to remain enabled.
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_POLL_MS=1000
NOTIFICATION_WORKER_LEASE_SECONDS=60
NOTIFICATION_WORKER_BATCH_SIZE=25
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=5

# One-time bootstrap. The script refuses to overwrite an existing admin account.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Legacy production PHI target retained for deployment compatibility.
PHI_KMS_PROVIDER=aws-kms
PHI_KMS_KEY_ID=

# Production telehealth provider override.
# TELEHEALTH_PROVIDER=livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Slice 10.13 durable FHIR Bulk Data processing.
# PostgreSQL is the durable source of truth. Redis remains a rollout-compatibility mirror plus lock/cancel/rate-limit layer.
BULK_EXPORT_WORKER_ENABLED=true
BULK_EXPORT_WORKER_POLL_MS=2000
BULK_EXPORT_WORKER_LEASE_SECONDS=300
BULK_EXPORT_WORKER_BATCH_SIZE=10
BULK_EXPORT_MAX_ATTEMPTS=3
BULK_EXPORT_RETRY_BASE_SECONDS=5
BULK_EXPORT_CLEANUP_INTERVAL_SECONDS=60
BULK_EXPORT_CLEANUP_BATCH_SIZE=25
BULK_EXPORT_REDIS_COMPAT_WRITE=true

# Bulk Data artifact storage. Production forbids local storage. Phase C3 inspects the actual
# S3 lifecycle configuration and requires an Enabled expiration rule covering this prefix
# within BULK_EXPORT_RETENTION_SECONDS; no manual lifecycle-confirmation flag is trusted.
BULK_EXPORT_STORAGE_PROVIDER=local
BULK_EXPORT_STORAGE_LOCAL_ROOT=/tmp/carepoint-bulk-export
BULK_EXPORT_S3_BUCKET=
BULK_EXPORT_S3_PREFIX=carepoint/bulk-export
BULK_EXPORT_S3_KMS_KEY_ID=
BULK_EXPORT_S3_FORCE_PATH_STYLE=false
BULK_EXPORT_RETENTION_SECONDS=86400
BULK_EXPORT_MAX_RESOURCES_PER_TYPE=10000
BULK_EXPORT_MAX_RESOURCES_PER_FILE=1000
BULK_EXPORT_MAX_TOTAL_RESOURCES=20000
BULK_EXPORT_MAX_TOTAL_BYTES=67108864
