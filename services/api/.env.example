NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://carepoint:carepoint@localhost:5432/carepoint?schema=public
REDIS_URL=redis://localhost:6379
ALLOWED_ORIGINS=http://localhost:3000

# Local/development MFA secret envelope encryption only.
# Generate a 32-byte key, for example: openssl rand -base64 32
MFA_KEY_PROVIDER=local
MFA_ENVELOPE_KEY_ID=local-mfa-kek-v1
MFA_ENVELOPE_KEY_BASE64=

# Local/development clinical PHI encryption only.
CLINICAL_KEY_PROVIDER=local
CLINICAL_ENVELOPE_KEY_ID=local-clinical-kek-v1
CLINICAL_ENVELOPE_KEY_BASE64=

# Local/development order/result encryption and attestation only.
ORDER_KEY_PROVIDER=local
ORDER_ENVELOPE_KEY_ID=local-orders-kek-v1
ORDER_ENVELOPE_KEY_BASE64=
ORDER_SIGNING_PROVIDER=local
ORDER_SIGNING_KEY_ID=local-orders-signing-v1
ORDER_SIGNING_SECRET_BASE64=

# Slice 5/5.1 clinical documents.
# Development/test may use the local adapters below. Production forbids them.
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_LOCAL_ROOT=/tmp/carepoint-documents
DOCUMENT_KEY_PROVIDER=local
DOCUMENT_ENVELOPE_KEY_ID=local-documents-kek-v1
DOCUMENT_ENVELOPE_KEY_BASE64=
DOCUMENT_SIGNING_PROVIDER=local
DOCUMENT_SIGNING_KEY_ID=local-documents-signing-v1
DOCUMENT_SIGNING_SECRET_BASE64=
DOCUMENT_SCAN_PROVIDER=mock
DICOMWEB_PROVIDER=mock

# Production clinical-document example (AWS + ClamAV + DICOMweb).
# Use workload identity / instance role credentials; do not put AWS access keys here.
AWS_REGION=
DOCUMENT_STORAGE_PROVIDER=s3
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_PREFIX=carepoint/clinical
DOCUMENT_S3_KMS_KEY_ID=
DOCUMENT_S3_FORCE_PATH_STYLE=false
DOCUMENT_KEY_PROVIDER=aws-kms
DOCUMENT_KMS_KEY_ID=
DOCUMENT_SIGNING_PROVIDER=aws-kms-hmac
DOCUMENT_SIGNING_KMS_KEY_ID=
DOCUMENT_SCAN_PROVIDER=clamav
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
DICOMWEB_PROVIDER=dicomweb
DICOMWEB_BASE_URL=

# Optional development/LocalStack endpoints only. C1 forbids AWS_ENDPOINT_URL_KMS in production.
AWS_ENDPOINT_URL_S3=
AWS_ENDPOINT_URL_KMS=

# Phase C1 production application KMS readiness.
# Production envelope providers default to aws-kms and must resolve to CUSTOMER-managed,
# Enabled, SYMMETRIC_DEFAULT / ENCRYPT_DECRYPT keys in AWS_REGION.
# AWS_KMS_ACCOUNT_ID is optional; when present, every validated KMS key must belong to that account.
AWS_KMS_ACCOUNT_ID=
MFA_KMS_KEY_ID=
CLINICAL_KMS_KEY_ID=
ORDER_KMS_KEY_ID=
DOCUMENT_KMS_KEY_ID=
MESSAGING_KMS_KEY_ID=
TELEHEALTH_KMS_KEY_ID=
# Document attestation uses a CUSTOMER-managed HMAC_256 / GENERATE_VERIFY_MAC key.
DOCUMENT_SIGNING_KMS_KEY_ID=
# Reserved for Phase C1.1. Orders attestation is still the isolated synchronous legacy adapter in C1.
ORDER_SIGNING_KMS_KEY_ID=

# Slice 6 payments. Mock is development/test only; production defaults to external.
# Card PAN/CVV must never be sent to CarePoint. Use only an opaque PSP paymentMethodToken.
PAYMENT_GATEWAY_PROVIDER=mock
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_API_KEY=

# Slice 6 insurance. externalPolicyRef must be an opaque reference issued by the payer/clearinghouse integration.
INSURANCE_GATEWAY_PROVIDER=mock
INSURANCE_GATEWAY_BASE_URL=
INSURANCE_GATEWAY_API_KEY=
INSURANCE_MOCK_PREAUTH_THRESHOLD_MINOR=10000

# Slice 6.2 claims/revenue cycle. Mock is development/test only; production defaults to external.
# The adapter sends normalized financial/claim context only. Do not place raw clinical notes or payer payloads in claim persistence.
CLAIMS_GATEWAY_PROVIDER=mock
CLAIMS_GATEWAY_BASE_URL=
CLAIMS_GATEWAY_API_KEY=
CLAIMS_MOCK_DENIAL_THRESHOLD_MINOR=100000

# Slice 7 secure messaging. Local envelope encryption is development/test only.
MESSAGING_KEY_PROVIDER=local
MESSAGING_ENVELOPE_KEY_ID=local-messaging-kek-v1
MESSAGING_ENVELOPE_KEY_BASE64=

# Slice 7 notification delivery. Mock is development/test only; production defaults to external.
# External notification payloads carry PHI-neutral template keys and internal entity references, never secure-message bodies or clinical notes.
NOTIFICATION_GATEWAY_PROVIDER=mock
NOTIFICATION_GATEWAY_BASE_URL=
NOTIFICATION_GATEWAY_API_KEY=

# One-time bootstrap. The script refuses to overwrite an existing admin account.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

TELEHEALTH_PROVIDER=livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Development/test telehealth envelope key. Production defaults TELEHEALTH_KEY_PROVIDER to aws-kms.
TELEHEALTH_KEY_PROVIDER=local
TELEHEALTH_ENVELOPE_KEY_ID=local-telehealth-kek-v1
TELEHEALTH_ENVELOPE_KEY_BASE64=

# Slice 10.13 durable FHIR Bulk Data processing.
# PostgreSQL is the durable source of truth. Redis remains a rollout-compatibility mirror plus lock/cancel/rate-limit layer.
BULK_EXPORT_WORKER_ENABLED=true
BULK_EXPORT_WORKER_POLL_MS=2000
BULK_EXPORT_WORKER_LEASE_SECONDS=300
BULK_EXPORT_WORKER_BATCH_SIZE=10
BULK_EXPORT_MAX_ATTEMPTS=3
BULK_EXPORT_RETRY_BASE_SECONDS=5
BULK_EXPORT_CLEANUP_INTERVAL_SECONDS=60
BULK_EXPORT_CLEANUP_BATCH_SIZE=25
BULK_EXPORT_REDIS_COMPAT_WRITE=true

# Bulk Data artifact storage. Production forbids local storage and requires an S3 lifecycle policy confirmation.
BULK_EXPORT_STORAGE_PROVIDER=local
BULK_EXPORT_STORAGE_LOCAL_ROOT=/tmp/carepoint-bulk-export
BULK_EXPORT_S3_BUCKET=
BULK_EXPORT_S3_PREFIX=carepoint/bulk-export
BULK_EXPORT_S3_KMS_KEY_ID=
BULK_EXPORT_S3_FORCE_PATH_STYLE=false
BULK_EXPORT_STORAGE_LIFECYCLE_CONFIRMED=false
BULK_EXPORT_RETENTION_SECONDS=86400
BULK_EXPORT_MAX_RESOURCES_PER_TYPE=10000
BULK_EXPORT_MAX_RESOURCES_PER_FILE=1000
BULK_EXPORT_MAX_TOTAL_RESOURCES=20000
BULK_EXPORT_MAX_TOTAL_BYTES=67108864