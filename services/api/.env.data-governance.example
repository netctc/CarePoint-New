# Release 1 data-governance deployment contract.
# These values are examples/placeholders only. Deployment/Legal/Privacy owners must replace
# them with the approved launch jurisdiction, provider regions, policy versions and retention
# schedule. Do not infer a country, regulator or retention period from this file.

DATA_RESIDENCY_JURISDICTION=<approved-jurisdiction>
DATA_RESIDENCY_REGION=<approved-cloud-region>
DATA_RESIDENCY_POLICY_VERSION=<approved-residency-policy-version>
DATA_RESIDENCY_EVIDENCE_REFERENCE=<r3-infrastructure-evidence-reference>
DATABASE_DEPLOYMENT_REGION=<approved-cloud-region>
REDIS_DEPLOYMENT_REGION=<approved-cloud-region>
# AWS_REGION must equal DATA_RESIDENCY_REGION. Existing S3 and KMS production preflights then
# validate the actual document bucket/KMS resources against that application data region.

# The policy JSON must explicitly contain every Release 1 data class. Values below are schema
# examples, NOT approved retention periods. Replace every <approved-days> placeholder.
# PRESERVE rules intentionally have no retentionDays field.
DATA_RETENTION_POLICY_JSON={"version":"<approved-retention-policy-version>","rules":[{"dataClass":"AUTH_EPHEMERAL","action":"DELETE","retentionDays":<approved-days>},{"dataClass":"IDENTITY_PROFILE","action":"PRESERVE"},{"dataClass":"CLINICAL_RECORD","action":"DELETE","retentionDays":<approved-days>},{"dataClass":"CLINICAL_DOCUMENT","action":"PURGE","retentionDays":<approved-days>},{"dataClass":"DIAGNOSTIC_REPORT","action":"DELETE","retentionDays":<approved-days>},{"dataClass":"CONSENT","action":"PRESERVE"},{"dataClass":"FINANCIAL","action":"PRESERVE"},{"dataClass":"COMMUNICATION","action":"DELETE","retentionDays":<approved-days>},{"dataClass":"AUDIT_SECURITY","action":"PRESERVE"}]}

# Required whenever the approved policy has DELETE/PURGE actions.
DATA_RETENTION_EXECUTION_ENABLED=false
DATA_RETENTION_EXECUTION_MODE=manual
DATA_RETENTION_APPROVAL_REFERENCE=<approved-policy-change-or-release-reference>
DATA_RETENTION_BATCH_SIZE=100

# Release 1 destructive support is deliberately narrow:
# AUTH_EPHEMERAL=DELETE; CLINICAL_RECORD=DELETE; CLINICAL_DOCUMENT=PURGE;
# DIAGNOSTIC_REPORT=DELETE; COMMUNICATION=DELETE.
# IDENTITY_PROFILE, CONSENT, FINANCIAL and AUDIT_SECURITY are PRESERVE-only in this release.
# If policy owners require a different destructive lifecycle, implement and approve that
# lifecycle before changing the production policy. The generic engine never hard-deletes audit.
